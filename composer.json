{
    "name": "carono/yii2-ai-dialog",
    "type": "yii2-extension",
    "description": "Yii2 widget that embeds an AI assistant dialog for use during development",
    "keywords": [
        "yii2",
        "ai",
        "dialog",
        "widget",
        "assistant",
        "development"
    ],
    "homepage": "https://github.com/carono/yii2-ai-dialog",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/carono/yii2-ai-dialog/issues?state=open",
        "source": "https://github.com/carono/yii2-ai-dialog",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89.1",
        "maglnet/composer-require-checker": "^4.7.1",
        "phpunit/phpunit": "^10.5.46",
        "rector/rector": "^2.0.16",
        "roave/infection-static-analysis-plugin": "^1.35",
        "spatie/phpunit-watcher": "^1.24",
        "vimeo/psalm": "^5.26.1 || ^6.10.3"
    },
    "autoload": {
        "psr-4": {
            "Carono\\AiDialog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Carono\\AiDialog\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "composer/package-versions-deprecated": true
        }
    },
    "scripts": {
        "test": "phpunit --testdox --no-interaction",
        "test-watch": "phpunit-watcher watch",
        "cs-fix": "php-cs-fixer fix"
    }
}
